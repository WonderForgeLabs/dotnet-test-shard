{
  "name": "dotnet-test-shard",
  "version": "1.0.0",
  "description": "GitHub Action for automatic .NET test sharding",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "all": "npm run format && npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WonderForgeLabs/dotnet-test-shard.git"
  },
  "keywords": [
    "github-action",
    "dotnet",
    "testing",
    "sharding",
    "ci"
  ],
  "author": "Elan Hasson",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.2",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^7.0.0",
    "@actions/io": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.21.0"
  }
}
